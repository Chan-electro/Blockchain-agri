# Server
PORT=3001
FRONTEND_URL=http://localhost:5173

# Blockchain
BLOCKCHAIN_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=
# Derives 4 role signers (farmer/processor/logistics/retailer) from HD paths
# m/44'/60'/0'/0/{1..4}. Default below is the standard Hardhat test mnemonic —
# safe for local dev only. NEVER use this on any public network.
MNEMONIC=test test test test test test test test test test test junk

# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=dev-secret-change-me-in-production
JWT_EXPIRES_IN=24h
